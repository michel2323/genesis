#!/bin/bash
#PBS -N genesis_probe
#PBS -A Julia
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=flare
#PBS -l place=scatter
#PBS -j oe
#PBS -o /lus/flare/projects/Julia/mschanen/git/genesis/aurora/logs/

# No `set -e`: every step runs even if an earlier one fails.
REPO=/lus/flare/projects/Julia/mschanen/git/genesis
cd "$REPO" || exit 1
source aurora/env.sh

banner() { echo; echo "######## $* ########  ($(date +%T))"; }

banner "STEP 0: GPU visibility"
command -v xpu-smi >/dev/null && xpu-smi discovery 2>&1 | head -40
command -v sycl-ls >/dev/null && sycl-ls 2>&1

banner "STEP 1: oneAPI driver/library probe (aurora/probe_env.jl)"
julia --project=. aurora/probe_env.jl
echo "== exit $?"

# repro/repro_simd32_fp64.jl aborts at sub_group_size=8, which PVC does not support (only 16, 32);
# the aurora/ copy skips unsupported sizes.
banner "STEP 2: aurora/repro_simd32_fp64_pvc.jl (repro/repro_simd32_fp64.jl minus unsupported sizes)"
julia --project=repro aurora/repro_simd32_fp64_pvc.jl
echo "== exit $?"

banner "STEP 3: repro/repro_ka_default.jl"
julia --project=repro repro/repro_ka_default.jl
echo "== exit $?"

# repro/kernel_args/run_all.sh calls `julia +1.12`, which the module's julia does not accept.
# The loop below is the same as run_all.sh with plain `julia` (run_all.sh itself is unchanged).
# IGC_OverrideOCLMaxParamSize and NEO_CACHE_PERSISTENT=0 are set only per probe process, as in
# run_all.sh; they are never exported into this job's environment.
# qsub -v KARGS_PROBE=0 aurora/probe.pbs  skips this step.
if [ "${KARGS_PROBE:-1}" != 0 ]; then
banner "STEP 4: repro/kernel_args (equivalent of run_all.sh)"
(
  cd repro/kernel_args
  for cfg in "1024 102" "4096 103" "8192 104" "4096 105"; do
    set -- $cfg
    log=log_override$1_salt$2.txt
    env IGC_OverrideOCLMaxParamSize=$1 NEO_CACHE_PERSISTENT=0 SALT=$2 julia --project=.. probe.jl > $log 2>&1
    echo "== override $1 salt $2 exit $?"
    grep -E "^RESULT|!!|^# (setting|done)" $log | sed -E 's/:: ZeError.*//'
  done
  # Baseline without the override (not in run_all.sh): what the 2048 B limit looks like here.
  log=log_unset_salt101.txt
  env NEO_CACHE_PERSISTENT=0 SALT=101 julia --project=.. probe.jl > $log 2>&1
  echo "== override unset salt 101 exit $?"
  grep -E "^RESULT|!!|^# (setting|done)" $log | sed -E 's/:: ZeError.*//'
)
fi

banner "DONE"
